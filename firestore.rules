rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // 관리자: 이메일 SHA-256 해시로 비교 (저장소가 공개라 이메일을 그대로 두지 않음, main.js ADMIN_HASHES와 같은 값)
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && hashing.sha256(myEmail().toUtf8()).toHexString().lower() == '8c4c2ef482a22848694d608da19923a106ffc3e525e676ccb67de45bd58b229a';
    }
    // 비공개 베타: 관리자이거나 allowlist에 이메일이 있는 사람만 앱 데이터 접근
    function allowed() {
      return signedIn() && request.auth.token.email_verified == true
        && (isAdmin() || exists(/databases/$(database)/documents/allowlist/$(myEmail())));
    }
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)); }
    function isMember(tripId) { return allowed() && request.auth.uid in tripDoc(tripId).data.members; }

    // 승인 목록: 본인 것만 조회, 관리자만 전체 보기·수정
    match /allowlist/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list, write: if isAdmin();
    }

    // 사용 요청: 승인 전 사용자가 본인 이메일로만 요청, 관리자가 보고 처리
    match /accessRequests/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow create, update: if signedIn() && email == myEmail()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.email == email;
      allow list, delete: if isAdmin();
    }

    // 초대 코드: 코드를 아는 사람만 하나씩 조회 가능 (목록 조회 금지)
    match /invites/{code} {
      allow get: if allowed();
      allow list: if false;
      allow create: if allowed() && isMember(request.resource.data.tripId)
                    && request.resource.data.createdBy == request.auth.uid;
      allow delete: if allowed() && isMember(resource.data.tripId);
    }

    // 프로필(이름·사진): 로그인한 사람은 보기, 본인만 수정
    match /users/{uid} {
      allow read: if allowed();
      allow write: if allowed() && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      allow read: if allowed() && request.auth.uid in resource.data.members;
      allow create: if allowed()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];
      allow update: if allowed() && (
        // 이미 참여 중인 사람: 수정 가능 (방장 변경은 방장만, 남은 참여자에게만)
        (request.auth.uid in resource.data.members
          // 다른 사람 내보내기는 방장만 (본인 나가기는 누구나)
          && (request.resource.data.members.hasAll(resource.data.members)
              || resource.data.ownerId == request.auth.uid
              || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
          && (request.resource.data.ownerId == resource.data.ownerId
              || (resource.data.ownerId == request.auth.uid
                  && request.resource.data.ownerId in request.resource.data.members)))
        ||
        // 초대 링크로 참여: 본인만 멤버에 추가, 유효한 초대 코드 필요
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'lastJoinCode'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.tripId == tripId)
      );
      allow delete: if allowed() && resource.data.ownerId == request.auth.uid;

      // 일정·항공권·가계부: 참여자만
      match /{sub}/{docId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
